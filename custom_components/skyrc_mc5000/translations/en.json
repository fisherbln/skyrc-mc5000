  "services": {
    "start_program": {
      "name": "Start program",
      "description": "Send a complete program to a slot and start it right away.",
      "fields": {
        "config_entry_id": {
          "name": "Charger",
          "description": "Only needed when more than one MC5000 is set up."
        },
        "slot": {
          "name": "Slot",
          "description": "Slot 1-4, or all four."
        },
        "battery_type": {
          "name": "Chemistry",
          "description": "Battery chemistry. Check it before starting."
        },
        "operation": {
          "name": "Operation",
          "description": "Charge, storage, discharge and cycle for lithium; charge, refresh, break-in, discharge and cycle for nickel."
        },
        "capacity": {
          "name": "Capacity",
          "description": "Battery capacity."
        },
        "charge_current": {
          "name": "Charge current",
          "description": ""
        },
        "discharge_current": {
          "name": "Discharge current",
          "description": ""
        },
        "charge_voltage": {
          "name": "Charge voltage",
          "description": "Defaults to the chemistry's maximum (e.g. 4200 mV for Li-ion); higher values are refused."
        },
        "discharge_voltage": {
          "name": "Discharge cutoff voltage",
          "description": "Defaults per chemistry (e.g. 3200 mV Li-ion, 900 mV NiMH)."
        },
        "storage_voltage": {
          "name": "Storage voltage",
          "description": "For the storage operation. Defaults per chemistry."
        },
        "charge_end_current": {
          "name": "Charge termination current",
          "description": ""
        },
        "discharge_end_current": {
          "name": "Discharge termination current",
          "description": ""
        },
        "rest_time": {
          "name": "Rest time",
          "description": "Rest between charge and discharge steps."
        },
        "cycle_count": {
          "name": "Cycles",
          "description": ""
        },
        "cycle_mode": {
          "name": "Cycle order",
          "description": "For the cycle operation: charge then discharge (ends empty), or discharge then charge (ends charged)."
        },
        "restart_voltage": {
          "name": "Restart voltage",
          "description": "After a lithium charge, start charging again if the cell drops below this voltage. 0 = off."
        },
        "delta_v": {
          "name": "-dV",
          "description": "NiMH/NiCd peak detection."
        },
        "trickle_current": {
          "name": "Trickle current",
          "description": "0 = off; 10 mA steps."
        },
        "protection_temperature": {
          "name": "Cutoff temperature",
          "description": ""
        },
        "protection_time": {
          "name": "Safety timer",
          "description": "0 = charger default."
        }
      }
    },
    "send_command": {
      "name": "Send raw command",
      "description": "For testing protocol commands: send one frame and return the charger's reply. Firmware, factory reset and password commands are refused.",
      "fields": {
        "config_entry_id": {
          "name": "Charger",
          "description": "Only needed when more than one MC5000 is set up."
        },
        "command": {
          "name": "Command",
          "description": "Command byte, e.g. 150 for 0x96."
        },
        "payload": {
          "name": "Payload",
          "description": "Hex bytes, e.g. '04'."
        }
      }
    },
    "get_history": {
      "name": "Get stored curve",
      "description": "Download the voltage curve the charger keeps for a running slot (one sample per second). Returns an empty list when the slot isn't running.",
      "fields": {
        "config_entry_id": {
          "name": "Charger",
          "description": "Only needed when more than one MC5000 is set up."
        },
        "slot": {
          "name": "Slot",
          "description": "Slot 1-4."
        }
      }
    }
